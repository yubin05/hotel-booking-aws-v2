        <mxCell id="v60" value="RPO = 장애 시각 − 도쿄 복원 데이터의 마지막 커밋 시각    (실제 순번 예약으로 확인)" style="rounded=0;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#ED8400;fontSize=19;fontFamily=Arial;fontStyle=1;dashed=0;dashPattern=8 5;fillOpacity=0;strokeOpacity=0;spacingLeft=8;" vertex="1" parent="1">
