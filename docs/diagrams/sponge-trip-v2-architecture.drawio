        <mxCell id="v89" value="본 자료는 구현 경로와 테스트 설계를 설명하며, 실측 RTO/RPO 값은 검증 결과에서 별도 제시. 그래프의 값은 임의로 만들지 않음." style="rounded=0;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#627187;fontSize=15;fontFamily=Arial;fontStyle=0;dashed=0;dashPattern=8 5;fillOpacity=0;strokeOpacity=0;spacingLeft=8;" vertex="1" parent="1">
