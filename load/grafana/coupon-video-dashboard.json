{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus (k6)",
      "description": "Grafana Cloud 스택의 Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_CLOUDWATCH",
      "label": "CloudWatch",
      "description": "Grafana Assume Role로 만든 CloudWatch",
      "type": "datasource",
      "pluginId": "cloudwatch",
      "pluginName": "CloudWatch"
    }
  ],
  "title": "Cloud Lab · 쿠폰 이벤트 촬영 관제",
  "uid": "cloudlab-coupon-video",
  "tags": [
    "cloud-lab",
    "k6",
    "video-demo"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 8,
      "type": "timeseries",
      "title": "초당 요청 수 (RPS · k6)",
      "description": "손님이 1초에 보낸 요청 수(쿠폰 + 같은 때 숙소 조회)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (testid) (irate(k6_http_reqs_total[10s]))",
          "legendFormat": "{{testid}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "stepAfter",
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 23,
      "type": "stat",
      "title": "HTTP 503 (k6 관측 누적)",
      "description": "조회 구간에 관측된 회차별 k6 503 누적 카운터. 다른 HTTP 요청 샘플이 있을 때만 503 미관측을 0으로 표시하며 No Data와 구분. 최종 수치는 원본 k6 기록으로 확인.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (testid) (max_over_time(k6_http_reqs_total{status=\"503\"}[$__range])) or (0 * sum by (testid) (max_over_time(k6_http_reqs_total[$__range])))",
          "legendFormat": "{{testid}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "쿠폰 서버 수 (ECS coupon)",
      "description": "쿠폰 발급 경로 전용 서비스. Desired/Running/ALB Healthy는 1분 관측이며 지연될 수 있음. 쿠폰 서버를 끄면 No Data.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "queryMode": "Metrics",
          "region": "ap-northeast-2",
          "namespace": "ECS/ContainerInsights",
          "metricName": "DesiredTaskCount",
          "dimensions": {
            "ClusterName": "hotel-booking-aws-v2",
            "ServiceName": "coupon"
          },
          "statistic": "Average",
          "period": "60",
          "matchExact": true,
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "label": "coupon 목표 태스크",
          "id": "",
          "expression": ""
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "queryMode": "Metrics",
          "region": "ap-northeast-2",
          "namespace": "ECS/ContainerInsights",
          "metricName": "RunningTaskCount",
          "dimensions": {
            "ClusterName": "hotel-booking-aws-v2",
            "ServiceName": "coupon"
          },
          "statistic": "Average",
          "period": "60",
          "matchExact": true,
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "label": "coupon 실행 태스크",
          "id": "",
          "expression": ""
        },
        {
          "refId": "C",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "queryMode": "Metrics",
          "region": "ap-northeast-2",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "period": "60",
          "id": "",
          "expression": "SEARCH('{AWS/ApplicationELB,LoadBalancer,TargetGroup} MetricName=\"HealthyHostCount\" AND TargetGroup=hotel AND TargetGroup=booking AND TargetGroup=coupon', 'Maximum', 60)",
          "label": "coupon 정상 대상 ${PROP('Dim.TargetGroup')}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "stepAfter",
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "쿠폰·조회 응답 시간 (p95)",
      "description": "p95는 전체 요청의 95%가 이 시간 안에 완료된다는 뜻. 쿠폰은 연결 대기와 응답, 조회는 검색·상세 응답. 1초 구간별 값이므로 전체 회차 p95와 차이가 날 수 있음.",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "H",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (testid) (k6_claim_duration_p95)",
          "legendFormat": "쿠폰 누름 {{testid}}",
          "range": true
        },
        {
          "refId": "I",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (testid) (k6_http_req_duration_p95{name=~\"search|hotel\"})",
          "legendFormat": "조회 {{testid}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "stepAfter",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    }
  ]
}