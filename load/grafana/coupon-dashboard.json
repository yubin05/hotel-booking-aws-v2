    {
      "id": 12,
      "type": "timeseries",
      "title": "일반 서버 수 (ECS app)",
      "description": "Desired = 목표 태스크, Running = 실제 실행 태스크, ALB Healthy = 트래픽을 받을 준비가 된 정상 대상. 태스크는 물리 서버가 아닌 컨테이너 실행 단위. 1분 단위 관측.",
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "targets": [
        {
          "refId": "K",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "queryMode": "Metrics",
          "region": "ap-northeast-2",
          "namespace": "ECS/ContainerInsights",
          "metricName": "DesiredTaskCount",
          "dimensions": {
            "ClusterName": "hotel-booking-aws-v2",
            "ServiceName": "app"
          },
          "statistic": "Average",
          "period": "60",
          "matchExact": true,
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "label": "app 목표 태스크 (Desired)",
          "id": "",
          "expression": ""
        },
        {
          "refId": "L",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "queryMode": "Metrics",
          "region": "ap-northeast-2",
          "namespace": "ECS/ContainerInsights",
          "metricName": "RunningTaskCount",
          "dimensions": {
            "ClusterName": "hotel-booking-aws-v2",
            "ServiceName": "app"
          },
          "statistic": "Average",
          "period": "60",
          "matchExact": true,
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "label": "app 실행 태스크 (Running)",
          "id": "",
          "expression": ""
        },
        {
          "refId": "M",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "queryMode": "Metrics",
          "region": "ap-northeast-2",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "period": "60",
          "id": "",
          "expression": "SEARCH('{AWS/ApplicationELB,LoadBalancer,TargetGroup} MetricName=\"HealthyHostCount\" AND TargetGroup=hotel AND TargetGroup=booking AND TargetGroup=app', 'Maximum', 60)",
