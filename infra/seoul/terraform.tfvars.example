# 이 루트의 실험 날 설정. terraform.tfvars로 복사해 쓴다(커밋 안 함). -var 대신 이 파일 (infra/README.md 0절)
# multi_az = true   # AZ 장애 · RDS 장애 조치 · 리전 드릴 날: NAT 2 + RDS Multi-AZ (ADR-034 · ADR-042)
# db_pool_size = [5, 1]   # DB 한계 시험(ADR-074 ②): 서버 8대 고정 × (5 + 1) = 48 연결, 끝나면 지움
# app_requests_target = 4800   # 늘리기 개선(ADR-074): CPU 기준에 요청 수 기준 추가(태스크 1대 1분 4,800건 = 초당 80건), 끝나면 지움
# coupon_service = true    # 쿠폰 격벽 실험(11-26~): 발급만 받는 서버 2대 + ALB 경로 규칙, 끝나면 지움
# alb_access_logs = true   # 진단하는 날: ALB 접근 로그 → bootstrap 버킷(7일 뒤 삭제), 끝나면 지움
# coupon_tasks = 4        # 쿠폰 서버 수(기본 2). 3,000명 쏠림은 4, 끝나면 지움
